flowchart TD

subgraph EDGE["External Channels"]
direction LR
CHANNELS["Channels<br/>Web / WhatsApp / Email / Channel Manager"]
end

subgraph ENTRY["Ingress Layer"]
direction LR
ADAPTERS["Entry / Adapters<br/>/api/chat, webhooks, parsers, adapters"]
end

subgraph CORE["Core Runtime"]
direction LR
PIPELINE["Message Pipeline<br/>normalize → identity → binding → handle → delivery"]
IDENTITY["Guest Identity<br/>guestId, aliases, merge policy"]
DECISION["Decision / Knowledge<br/>LangGraph, prompts, retrieval, MCP"]
PERSISTENCE["Persistence<br/>Astra / Cassandra operational + KB"]
end

subgraph ADMIN["Operations"]
direction LR
PANEL["Admin Panel<br/>Inbox, Guests, Knowledge, Hotels, Users"]
end

CHANNELS --> ADAPTERS
ADAPTERS --> PIPELINE
PIPELINE --> IDENTITY
PIPELINE --> DECISION
PIPELINE --> PERSISTENCE
IDENTITY --> PERSISTENCE
DECISION --> PERSISTENCE
PANEL -. reads .-> PIPELINE
PANEL -. reads .-> IDENTITY
PANEL -. reads .-> PERSISTENCE
PIPELINE --> CHANNELS

